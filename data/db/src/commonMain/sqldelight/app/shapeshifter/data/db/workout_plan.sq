CREATE TABLE workout_plan (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `routine_id` INTEGER NOT NULL,
    `name` TEXT NOT NULL
);

insert:
INSERT INTO workout_plan (`id`, `routine_id`, `name`)
VALUES (
nullif(:id, 0),
:routineId,
:name
);

update:
UPDATE workout_plan SET
    routine_id = :routineId,
    name = :name
WHERE id = :id;

selectAll:
SELECT * FROM workout_plan;

select:
SELECT * FROM workout_plan
    WHERE id = :id;

delete:
DELETE FROM workout_plan WHERE
id = :id;

lastInsertRowId:
SELECT last_insert_rowid();
