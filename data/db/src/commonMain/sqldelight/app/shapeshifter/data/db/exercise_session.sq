selectExerciseSession:
SELECT
    elog.id AS exercise_log_id,
    elog.exercise_index AS exercise_index,
    elog.exercise_template_id AS exercise_id,
    elog.workout_log_id AS workout_log_id,
    elog.exercise_plan_id AS exercise_plan_id,
    elog.rest_time_duration AS exercise_rest_time_duration,
    slog.id AS set_log_id,
    slog.reps AS set_log_reps,
    slog.weight AS set_log_weight,
    slog.is_completed AS set_completed,
    slog.set_type_id AS set_type_id,
    e.name AS exercise_name,
    e.image_url AS exercise_image_url,
    e.primary_muscle AS exercise_primary_muscle,
    e.secondary_muscles AS exercise_secondary_muscles,
    (
        SELECT NULLIF(slog_sub.reps, slog_sub.reps)
            FROM set_log AS slog_sub
            LEFT JOIN exercise_log AS elog_sub ON slog_sub.exercise_log_id = elog_sub.id
            WHERE elog_sub.exercise_template_id = elog.exercise_template_id
            AND (
                elog.workout_log_id = -1
                OR elog_sub.workout_log_id = elog.workout_log_id
            )
            AND slog_sub.id < slog.id
            ORDER BY slog_sub.id DESC
            LIMIT 1
    ) AS set_prev_reps,
    (
        SELECT NULLIF(slog_sub.weight, slog_sub.weight)
            FROM set_log AS slog_sub
            LEFT JOIN exercise_log AS elog_sub ON slog_sub.exercise_log_id = elog_sub.id
            WHERE elog_sub.exercise_template_id = elog.exercise_template_id
            AND (
                elog.workout_log_id = -1
                OR elog_sub.workout_log_id = elog.workout_log_id
            )
            AND slog_sub.id < slog.id
            ORDER BY slog_sub.id DESC
            LIMIT 1
    ) AS set_prev_weight
FROM
    exercise_log AS elog
JOIN
    set_log AS slog ON slog.exercise_log_id = elog.id
JOIN
    exercise_template AS e ON e.id = elog.exercise_template_id
WHERE
    elog.id = :exerciseLogId
ORDER BY elog.id DESC
LIMIT 1;
