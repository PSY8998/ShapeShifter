CREATE TABLE IF NOT EXISTS set_log (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `exercise_log_id` INTEGER NOT NULL,
    `set_type_id` INTEGER NOT NULL DEFAULT 2,
    `set_index` INTEGER NOT NULL,
    `weight` INTEGER NOT NULL,
    `reps` INTEGER NOT NULL,
    `is_completed` INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (`exercise_log_id`) REFERENCES `exercise_log`(`id`) ON UPDATE CASCADE ON DELETE CASCADE,
    FOREIGN KEY (`set_type_id`) REFERENCES `set_type`(`id`) ON UPDATE CASCADE
);

-- indices
CREATE INDEX IF NOT EXISTS `index_set_exercise_log_id` ON `set_log` (`exercise_log_id`);
CREATE INDEX IF NOT EXISTS `index_set_set_type_id` ON `set_log` (`set_type_id`);

insert:
INSERT INTO set_log(
    id,
    exercise_log_id,
    set_type_id,
    set_index,
    weight,
    reps,
    is_completed
)
VALUES (
    nullIf(:id, 0),
    :exerciseLogId,
    :setTypeId,
    :setIndex,
    :weight,
    :reps,
    :isCompleted
);

update:
UPDATE set_log SET
    exercise_log_id = :exerciseLogId,
    set_type_id = :setTypeId,
    weight = :weight,
    reps = :reps,
    is_completed = :isCompleted
WHERE id = :id;


delete:
DELETE FROM set_log
    WHERE id = :id
;

exerciseLastSet:
SELECT *
FROM set_log
WHERE exercise_log_id = :exerciseLogId
ORDER BY id DESC
LIMIT 1;

setFromWorkoutPlan:
SELECT
  COALESCE(
    (SELECT sl.weight
     FROM set_log AS sl
     JOIN exercise_log AS el ON sl.exercise_log_id = el.id
     WHERE el.workout_log_id        = :lastWorkoutLogId
       AND el.exercise_template_id  = :exerciseTemplateId
       AND sl.set_index             = :setIndex
     ORDER BY el.id DESC, sl.id DESC
     LIMIT 1),
    (SELECT weight
     FROM set_log
     WHERE exercise_log_id = :currentExerciseLogId
     ORDER BY id DESC
     LIMIT 1)
  ) AS weight,
  COALESCE(
    (SELECT sl.reps
     FROM set_log AS sl
     JOIN exercise_log AS el ON sl.exercise_log_id = el.id
     WHERE el.workout_log_id        = :lastWorkoutLogId
       AND el.exercise_template_id  = :exerciseTemplateId
       AND sl.set_index             = :setIndex
     ORDER BY el.id DESC, sl.id DESC
     LIMIT 1),
    (SELECT reps
     FROM set_log
     WHERE exercise_log_id = :currentExerciseLogId
     ORDER BY id DESC
     LIMIT 1)
  ) AS reps;


setsFromLatestExerciseLog:
SELECT
  idx.set_index    AS setIndex,
  COALESCE(
    -- 1) last weight for this index from previous logs of same template
    (SELECT sl.weight
     FROM set_log sl
     JOIN exercise_log el ON sl.exercise_log_id = el.id
     WHERE el.exercise_template_id = :exerciseTemplateId
       AND sl.set_index = idx.set_index
     ORDER BY el.id DESC, sl.id DESC
     LIMIT 1),
    -- 2) weight for this index in current log (if already entered)
    (SELECT weight
     FROM set_log
     WHERE exercise_log_id = :currentExerciseLogId
       AND set_index = idx.set_index
     LIMIT 1),
    -- 3) last weight of any set in current log
    (SELECT weight
     FROM set_log
     WHERE exercise_log_id = :currentExerciseLogId
     ORDER BY id DESC
     LIMIT 1)
  ) AS weight,
  COALESCE(
    (SELECT sl.reps
     FROM set_log sl
     JOIN exercise_log el ON sl.exercise_log_id = el.id
     WHERE el.exercise_template_id = :exerciseTemplateId
       AND sl.set_index = idx.set_index
     ORDER BY el.id DESC, sl.id DESC
     LIMIT 1),
    (SELECT reps
     FROM set_log
     WHERE exercise_log_id = :currentExerciseLogId
       AND set_index = idx.set_index
     LIMIT 1),
    (SELECT reps
     FROM set_log
     WHERE exercise_log_id = :currentExerciseLogId
     ORDER BY id DESC
     LIMIT 1)
  ) AS reps
FROM (
  -- all set indexes seen in current log or past logs
  SELECT DISTINCT set_index
  FROM set_log
  WHERE exercise_log_id = :currentExerciseLogId
  UNION
  SELECT DISTINCT sl.set_index
  FROM set_log sl
  JOIN exercise_log el ON sl.exercise_log_id = el.id
  WHERE el.exercise_template_id = :exerciseTemplateId
) AS idx
ORDER BY setIndex;

lastInsertRowId:
SELECT last_insert_rowid();
