-- a workout log may belong to plan or may not
CREATE TABLE IF NOT EXISTS workout_log (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `workout_plan_id` INTEGER,
    `name` TEXT NOT NULL,
    `note` TEXT,
    `start_time` INTEGER NOT NULL,
    `finish_time` INTEGER,
    `rest_finish_at` INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS index_workout_plan_id ON workout_log(workout_plan_id);

insert:
INSERT INTO workout_log (
`id`,
`workout_plan_id`,
`name`,
`start_time`,
`finish_time`,
`rest_finish_at`
)
VALUES (
nullif(:id, 0),
:workoutPlanId,
:name,
:startTime,
:finishTime,
:restFinishAt
);

update:
UPDATE workout_log SET
workout_plan_id = :workoutPlanId,
start_time = :startTime,
finish_time = :finishTime,
name = :name,
rest_finish_at = :restFinishAt
WHERE id = :id;

lastInsertRowId:
SELECT last_insert_rowid();

activeWorkoutLogOverview:
SELECT
routine.id,
routine.name,
workout_log.workout_plan_id,
workout_plan.name,
workout_log.id,
workout_log.name,
workout_log.start_time,
workout_log.finish_time,
workout_log.rest_finish_at
FROM workout_log
LEFT JOIN workout_plan ON workout_log.workout_plan_id = workout_plan.id
LEFT JOIN routine ON workout_plan.routine_id = routine.id
WHERE workout_log.finish_time = 0
LIMIT 1;

delete:
DELETE FROM workout_log WHERE id = :workoutId;
