CREATE TABLE IF NOT EXISTS `exercise_log` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `exercise_index` INTEGER NOT NULL,
    `exercise_template_id` INTEGER NOT NULL,
    `workout_log_id` INTEGER NOT NULL,
    `exercise_plan_id` INTEGER,
    `rest_time_duration` INTEGER NOT NULL,
    FOREIGN KEY (`workout_log_id`) REFERENCES `workout_log`(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

-- indices
CREATE INDEX IF NOT EXISTS `index_exercise_workout_log_id` ON `exercise_log` (`workout_log_id`);
CREATE INDEX IF NOT EXISTS `index_exercise_id` ON `exercise_log` (`exercise_template_id`);
CREATE INDEX IF NOT EXISTS `index_exercise_plan_id` ON `exercise_log` (`exercise_plan_id`);

-- queries
insert:
INSERT INTO exercise_log (
    `id`,
    `exercise_index`,
    `exercise_template_id`,
    `workout_log_id`,
    `exercise_plan_id`,
    `rest_time_duration`
)
VALUES (
    nullif(:id, 0),
    :exerciseIndex,
    :exerciseTemplateId,
    :workoutLogId,
    :exercisePlanId,
    :restTimeDuration
);

update:
UPDATE exercise_log SET
    rest_time_duration = :restTimeDuration,
    exercise_index = :exerciseIndex
WHERE id = :id;

delete:
DELETE FROM exercise_log
WHERE id = :id
;

selectAll:
SELECT * FROM exercise_log
WHERE `workout_log_id` = :workout_id;

lastInsertRowId:
SELECT last_insert_rowid();


