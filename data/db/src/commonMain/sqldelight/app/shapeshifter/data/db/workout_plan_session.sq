selectWorkoutPlanSession:
SELECT
wplan.id AS workout_plan_id,
wplan.name AS workout_plan_name,
wplan.routine_id AS workout_plan_routine_id,
e.id AS exercise_id,
e.name AS exercise_name,
e.primary_muscle AS exercise_primary_muscle,
e.secondary_muscles AS exercise_secondary_muscles,
eplan.id AS exercise_plan_id,
splan.id AS set_plan_id,
splan.reps,
splan.weight
FROM
    workout_plan wplan
LEFT JOIN
    exercise_plan eplan ON wplan.id = eplan.workout_plan_id
LEFT JOIN
    exercise e ON eplan.exercise_id = e.id
LEFT JOIN
    set_plan splan ON eplan.id = splan.exercise_plan_id
WHERE
    wplan.id = :workout_plan_id
;

observeWorkoutSessions:
SELECT
wplan.id AS workout_plan_id,
wplan.name AS workout_plan_name,
wplan.routine_id AS workout_plan_routine_id,
e.id AS exercise_id,
e.name AS exercise_name,
e.primary_muscle AS exercise_primary_muscle,
e.secondary_muscles AS exercise_secondary_muscles,
eplan.id AS exercise_plan_id,
splan.id AS set_plan_id,
splan.reps,
splan.weight
FROM
    workout_plan wplan
LEFT JOIN
    exercise_plan eplan ON wplan.id = eplan.workout_plan_id
LEFT JOIN
    exercise e ON eplan.exercise_id = e.id
LEFT JOIN
    set_plan splan ON eplan.id = splan.exercise_plan_id;
