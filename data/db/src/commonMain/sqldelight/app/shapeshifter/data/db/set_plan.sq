-- set_plan has many to one relationship with exercise_plan
CREATE TABLE IF NOT EXISTS set_plan (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `exercise_plan_id` INTEGER NOT NULL,
    `weight` INTEGER NOT NULL,
    `reps` INTEGER NOT NULL,
    FOREIGN KEY (`exercise_plan_id`) REFERENCES exercise_plan(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

insert:
INSERT INTO set_plan(
id,
exercise_plan_id,
weight,
reps
)
VALUES (
nullIf(:id, 0),
:exercisePlanId,
:weight,
:reps
);

update:
UPDATE set_plan SET
    weight = :weight,
    reps = :reps
WHERE id = :id;

selectAll:
SELECT * FROM set_plan;

lastInsertRowId:
SELECT last_insert_rowid();
