-- exercise_plan has many to one relationship with workout_plan
-- many to many relationship between routine and exercise
CREATE TABLE IF NOT EXISTS exercise_plan (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `exercise_id` INTEGER NOT NULL,
    `workout_plan_id` INTEGER NOT NULL,
    FOREIGN KEY (`workout_plan_id`) REFERENCES workout_plan(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

insert:
INSERT INTO exercise_plan(
id,
exercise_id,
workout_plan_id
)
VALUES (
nullIf(:id, 0),
:exerciseId,
:workoutPlanId
);

update:
UPDATE exercise_plan SET
    exercise_id = :exerciseId,
    workout_plan_id = :workoutPlanId
WHERE id = :id;

selectAll:
SELECT
    eplan.id AS exercise_plan_id,
    eplan.workout_plan_id AS workout_plan_id,
    eplan.exercise_id AS exercise_id,
    e.name AS exercise_name,
    e.image_url AS exercise_image_url,
    e.primary_muscle AS exercise_primary_muscle,
    e.secondary_muscles AS exercise_secondary_muscles
FROM exercise_plan AS eplan
JOIN exercise AS e ON e.id = eplan.exercise_id;

lastInsertRowId:
SELECT last_insert_rowid();

