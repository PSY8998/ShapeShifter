-- exercise_plan has many to one relationship with workout_plan
-- many to many relationship between routine and exercise
CREATE TABLE IF NOT EXISTS exercise_plan (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `exercise_template_id` INTEGER NOT NULL,
    `workout_plan_id` INTEGER NOT NULL,
    `note` TEXT,
    FOREIGN KEY (`workout_plan_id`) REFERENCES workout_plan(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS index_exercise_plan_workout_plan_id ON exercise_plan(workout_plan_id);
CREATE INDEX IF NOT EXISTS index_exercise_plan_exercise_template_id ON exercise_plan(exercise_template_id);

insert:
INSERT INTO exercise_plan(
id,
exercise_template_id,
workout_plan_id
)
VALUES (
nullIf(:id, 0),
:exerciseTemplateId,
:workoutPlanId
);

update:
UPDATE exercise_plan SET
    exercise_template_id = :exerciseTemplateId,
    workout_plan_id = :workoutPlanId
WHERE id = :id;

selectAll:
SELECT
    eplan.id AS exercisePlanId,
    eplan.workout_plan_id AS workoutPlanId,
    eplan.exercise_template_id AS exerciseTemplateId,
    e.name AS exerciseName,
    e.image_url AS exerciseImageUrl,
    e.primary_muscle AS exercisePrimaryMuscle,
    e.secondary_muscles AS exerciseSecondaryMuscles
FROM exercise_plan AS eplan
JOIN exercise_template AS e ON e.id = eplan.exercise_template_id;

lastInsertRowId:
SELECT last_insert_rowid();

