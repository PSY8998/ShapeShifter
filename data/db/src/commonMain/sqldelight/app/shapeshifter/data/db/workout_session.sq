selectWorkoutSession:
SELECT
    wlog.id AS workout_log_id,
    wlog.workout_plan_id AS workout_plan_id,
    wlog.start_time AS workout_start_time,
    wlog.finish_time AS workout_finish_time,
    e.id AS exercise_id,
    e.name AS exercise_name,
    e.primary_muscle AS exercise_primary_muscle,
    e.secondary_muscles AS exercise_secondary_muscles,
    elog.id AS exercise_log_id,
    elog.exercise_plan_id AS exercise_plan_id,
    slog.id AS set_log_id,
    slog.finish_time AS set_finish_time,
    slog.weight,
    slog.reps,
    (
            SELECT NULLIF(slog_sub.reps, NULL)
            FROM set_log AS slog_sub
            LEFT JOIN exercise_log AS elog_sub ON slog_sub.exercise_log_id = elog_sub.id
            LEFT JOIN workout_log AS wlog_sub ON elog_sub.workout_log_id = wlog_sub.id
            WHERE elog_sub.exercise_id = elog.exercise_id
            AND (
                wlog_sub.workout_plan_id = :workoutPlanId
                OR elog_sub.workout_log_id = elog.workout_log_id
            )
            AND slog_sub.id < slog.id
            ORDER BY slog_sub.id DESC
            LIMIT 1
        ) AS set_prev_reps,
        (
            SELECT NULLIF(slog_sub.weight, NULL)
            FROM set_log AS slog_sub
            LEFT JOIN exercise_log AS elog_sub ON slog_sub.exercise_log_id = elog_sub.id
            LEFT JOIN workout_log AS wlog_sub ON elog_sub.workout_log_id = wlog_sub.id
            WHERE elog_sub.exercise_id = elog.exercise_id
            AND (
                wlog_sub.workout_plan_id = :workoutPlanId
                OR elog_sub.workout_log_id = elog.workout_log_id
            )
            AND slog_sub.id < slog.id
            ORDER BY slog_sub.id DESC
            LIMIT 1
        ) AS set_prev_weight
FROM
    workout_log wlog
LEFT JOIN
    exercise_log elog ON wlog.id = elog.workout_log_id
LEFT JOIN
    exercise e ON elog.exercise_id = e.id
LEFT JOIN
    set_log slog ON elog.id = slog.exercise_log_id
WHERE
    wlog.id = :workoutLogId;
