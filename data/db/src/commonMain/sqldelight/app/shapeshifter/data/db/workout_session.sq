selectWorkoutSession:
SELECT
    wlog.id AS workout_log_id,
    wlog.workout_plan_id AS workout_plan_id,
    wlog.start_time AS workout_start_time,
    wlog.finish_time AS workout_finish_time,
    wlog.name AS workout_log_name,
    wlog.rest_finish_at AS workout_rest_finish_at,
    e.id AS exercise_id,
    e.name AS exercise_name,
    e.primary_muscle AS exercise_primary_muscle,
    e.secondary_muscles AS exercise_secondary_muscles,
    elog.id AS exercise_log_id,
    elog.exercise_index AS exercise_log_index,
    elog.exercise_plan_id AS exercise_plan_id,
    elog.rest_time_duration AS exercise_rest_time_duration,
    slog.id AS set_log_id,
    slog.is_completed AS set_completed,
    slog.weight,
    slog.reps,
    slog.set_index,
    slog.set_type_id
FROM
    workout_log wlog
LEFT JOIN
    exercise_log elog ON wlog.id = elog.workout_log_id
LEFT JOIN
    exercise_template e ON elog.exercise_template_id = e.id
LEFT JOIN
    set_log slog ON elog.id = slog.exercise_log_id
WHERE
    wlog.id = :workoutLogId
ORDER BY
    elog.exercise_index;

workoutSessions:
SELECT
    wlog.id AS workout_log_id,
    wlog.workout_plan_id AS workout_plan_id,
    wlog.start_time AS workout_start_time,
    wlog.finish_time AS workout_finish_time,
    wlog.name AS workout_log_name,
    wlog.rest_finish_at AS workout_rest_finish_at,
    e.id AS exercise_id,
    e.name AS exercise_name,
    e.primary_muscle AS exercise_primary_muscle,
    e.secondary_muscles AS exercise_secondary_muscles,
    elog.id AS exercise_log_id,
    elog.exercise_index AS exercise_log_index,
    elog.exercise_plan_id AS exercise_plan_id,
    elog.rest_time_duration AS exercise_rest_time_duration,
    slog.id AS set_log_id,
    slog.is_completed AS set_completed,
    slog.weight,
    slog.reps,
    slog.set_index,
    slog.set_type_id
FROM
    workout_log wlog
LEFT JOIN
    exercise_log elog ON wlog.id = elog.workout_log_id
LEFT JOIN
    exercise_template e ON elog.exercise_template_id = e.id
LEFT JOIN
    set_log slog ON elog.id = slog.exercise_log_id;
